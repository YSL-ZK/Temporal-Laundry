NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
APP_URL=http://localhost:3000
# Server-only. Required for privileged finance RPCs, invitations, receipt uploads, and AI usage quotas.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Server-only daily exchange-rate refresh. DATOS_GOV_APP_TOKEN is optional but
# recommended after rotating the token used during development.
DATOS_GOV_APP_TOKEN=your_rotated_datos_gov_app_token
CRON_SECRET=generate_a_random_secret_at_least_16_characters_long

# Server-only AI configuration. Never add NEXT_PUBLIC_ to either variable.
# Laundry allows only the free-model IDs defined in lib/groq.ts.
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
